<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_focuspet_card"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/history_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_focuspet_lavender"
        android:gravity="center"
        android:text="✓"
        android:textColor="@color/focuspet_purple"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/history_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/focuspet_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/history_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/focuspet_muted_text"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/history_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/focuspet_purple_dark"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
