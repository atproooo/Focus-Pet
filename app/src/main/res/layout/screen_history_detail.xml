<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:id="@+id/history_detail_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:text="‹  Back to statistics"
        android:textColor="@color/focuspet_purple_dark"
        android:textSize="16sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/history_detail_art"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_focuspet_image_placeholder"
        android:contentDescription="Reserved focus session illustration space"
        android:gravity="center"
        android:text="FOCUS SESSION&#10;ILLUSTRATION"
        android:textColor="@color/focuspet_purple"
        android:textSize="21sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/history_detail_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="18dp"
        android:textColor="@color/focuspet_purple_dark"
        android:textSize="25sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/history_detail_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textColor="@color/focuspet_muted_text"
        android:textSize="17sp" />
    <LinearLayout
        android:id="@+id/history_detail_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_focuspet_card"
        android:orientation="vertical"
        android:padding="16dp" />
    <TextView
        android:id="@+id/history_detail_rewards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_focuspet_lavender"
        android:padding="16dp"
        android:textColor="@color/focuspet_muted_text"
        android:textSize="16sp" />
</LinearLayout>
