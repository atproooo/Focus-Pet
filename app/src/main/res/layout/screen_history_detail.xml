<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:id="@+id/history_detail_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_focuspet_back"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:fontFamily="sans"
        android:text="&lt; Back to statistics"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />
    <FrameLayout
        android:id="@+id/history_detail_art"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_focuspet_image_placeholder"
        android:clipChildren="false"
        android:clipToPadding="false" />
    <TextView
        android:id="@+id/history_detail_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="18dp"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/history_detail_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:fontFamily="sans"
        android:textColor="@color/text_secondary"
        android:textSize="18sp" />
    <LinearLayout
        android:id="@+id/history_detail_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_focuspet_card"
        android:orientation="vertical"
        android:padding="16dp" />
    <LinearLayout
        android:id="@+id/history_detail_rewards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_focuspet_lavender"
        android:orientation="vertical"
        android:padding="16dp"
        android:importantForAccessibility="yes" />
</LinearLayout>
