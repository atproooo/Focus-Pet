<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pet_card"
    android:layout_width="match_parent"
    android:layout_height="158dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_focuspet_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/pet_image_placeholder"
        android:layout_width="112dp"
        android:layout_height="128dp"
        android:background="@drawable/bg_focuspet_lavender"
        android:contentDescription="Reserved pet artwork"
        android:gravity="center"
        android:text="PET&#10;ART"
        android:textColor="@color/focuspet_purple"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pet_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/focuspet_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pet_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/focuspet_purple"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pet_mood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mood / energy placeholder"
            android:textColor="@color/focuspet_muted_text"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/pet_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:max="100"
            android:progressTint="@color/focuspet_purple" />

        <TextView
            android:id="@+id/pet_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/focuspet_muted_text"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
