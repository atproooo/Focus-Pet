<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Preview your pet"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <include
        android:id="@+id/hatch_final_preview"
        layout="@layout/view_pet_animation"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/hatch_preview_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="12dp"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/hatch_preview_cost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="8dp"
        android:fontFamily="sans"
        android:text="Confirming will use 1 Pet Egg and 100 Life Essence."
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

</LinearLayout>
