<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/pet_detail_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:text="‹  Back to collection"
        android:textColor="@color/focuspet_purple_dark"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pet_detail_art"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_focuspet_image_placeholder"
        android:contentDescription="Reserved large pet artwork and animation space"
        android:gravity="center"
        android:text="PET ARTWORK&#10;/ ANIMATION"
        android:textColor="@color/focuspet_purple"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pet_detail_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="18dp"
        android:textColor="@color/focuspet_purple_dark"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pet_detail_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textColor="@color/focuspet_muted_text"
        android:textSize="17sp" />

    <ProgressBar
        android:id="@+id/pet_detail_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="14dp"
        android:max="100"
        android:progressTint="@color/focuspet_purple" />

    <TextView
        android:id="@+id/pet_detail_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="18dp"
        android:textColor="@color/focuspet_muted_text"
        android:textSize="17sp" />

    <LinearLayout
        android:id="@+id/pet_detail_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_focuspet_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Future interactions"
            android:textColor="@color/focuspet_purple_dark"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="Reserved for feeding, customization, and pet interaction controls."
            android:textColor="@color/focuspet_muted_text"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
