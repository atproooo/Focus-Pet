<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/pet_detail_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_focuspet_back"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:fontFamily="sans"
        android:text="&lt; Back to collection"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <include
        layout="@layout/view_pet_animation"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/pet_detail_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="18dp"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pet_detail_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:fontFamily="sans"
        android:textColor="@color/text_secondary"
        android:textSize="18sp" />

    <ProgressBar
        android:id="@+id/pet_detail_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="14dp"
        android:max="100"
        android:progressTint="@color/progress_foreground"
        android:progressBackgroundTint="@color/progress_track" />

    <TextView
        android:id="@+id/pet_detail_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="18dp"
        android:fontFamily="sans"
        android:textColor="@color/text_secondary"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/pet_detail_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_focuspet_card"
        android:orientation="vertical"
        android:padding="14dp">

    </LinearLayout>
</LinearLayout>
